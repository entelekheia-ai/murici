# Where each node of Murici's knowledge graph lives. Nodes come from
# lib/knowledge/cerrado-adapter.ts, whose `type` is one of conversation,
# knowledge or agent; routing reads `type` only, never the identifier.
# Bump `version` whenever an anchor moves or a rule changes: it is part of the
# saved-layout key, and an old layout would hide the change.
id: murici_knowledge
name: "Murici knowledge"
version: 1
zoom:
  fit_margin: 0.3
  max_magnification: 5
  elastic: 0.1
regions:
  - id: reg_agents
    label: "Agents"
    anchor_position: { x: 0, y: -700 }
    radius: 220
    mass: 1.2
    color: "#a78bfa"
    canopy_gradient: ["rgba(167, 139, 250, 0.30)", "rgba(76, 29, 149, 0)"]
  - id: reg_conversations
    label: "Conversations"
    anchor_position: { x: -650, y: 400 }
    radius: 320
    color: "#60a5fa"
    canopy_gradient: ["rgba(96, 165, 250, 0.30)", "rgba(30, 64, 175, 0)"]
  - id: reg_knowledge
    label: "Knowledge"
    anchor_position: { x: 650, y: 400 }
    radius: 320
    color: "#34d399"
    canopy_gradient: ["rgba(52, 211, 153, 0.30)", "rgba(6, 95, 70, 0)"]
relations:
  - { source: reg_conversations, target: reg_knowledge, type: generated_in, physics_weight: 0.7 }
  - { source: reg_agents, target: reg_conversations, type: ran_in, physics_weight: 0.4 }
  - { source: reg_agents, target: reg_knowledge, type: produced, physics_weight: 0.3 }
routing_rules:
  - match: { type: agent }
    assign_to: reg_agents
  - match: { type: conversation }
    assign_to: reg_conversations
  - match: { type: knowledge }
    assign_to: reg_knowledge
