    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.81.0",
    "react-i18next": "^14.1.3",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "react-textarea-autosize": "^8.5.9",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.8",
    "vis-data": "^8.0.4",
    "vis-network": "^10.1.0",
