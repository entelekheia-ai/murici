{
  "name": "murici",
  "version": "0.12.0-alpha.1",
  "description": "Murici is a lightweight, responsive desktop and web Chat UI designed for running deterministic state-machine agent behaviors.",
  "private": true,
  "author": "Danilo Borges <contato@daniloborg.es>",
  "homepage": "https://entelekheia.ai/",
  "contributors": [
    {
      "name": "Danilo Borges",
      "email": "contato@daniloborg.es"
    }
  ],
  "main": "electron-dist/main.js",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "analyze": "ANALYZE=true npm run build",
    "preview": "next build --webpack && next start",
    "type-check": "tsc --noEmit",
    "format:write": "prettier --write \"{app,lib,components,context,types}/**/*.{ts,tsx}\" --cache",
    "format:check": "prettier --check \"{app,lib,components,context,types}**/*.{ts,tsx}\" --cache",
    "test": "jest",
    "test:e2e": "playwright test",
    "build:agents": "node scripts/build-agents.js",
    "electron:compile": "rm -rf electron-dist && tsc -p tsconfig.electron.json",
    "electron:dev": "npm run electron:compile && NODE_ENV=development ELECTRON_ENV=development concurrently -k -n next,electron \"next dev --webpack\" \"wait-on http://localhost:3000 && electron electron-dist/main.js\"",
    "electron:build": "ELECTRON_BUILD=1 npm run build && cp -r .next/static .next/standalone/.next/static && cp -r public .next/standalone/public && npm run electron:compile && node scripts/verify-electron-deps.js && electron-builder",
    "electron:publish": "npm run electron:build -- --publish always",
    "postinstall": "node scripts/copy-tree-sitter-assets.js",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.8",
    "@ai-sdk/azure": "^4.0.8",
    "@ai-sdk/google": "^4.0.8",
    "@ai-sdk/mistral": "^4.0.5",
    "@ai-sdk/openai": "^4.0.8",
    "@ai-sdk/react": "^4.0.17",
    "@apidevtools/json-schema-ref-parser": "^16.0.3",
    "@dot-agent/compiler": "0.12.0",
    "@dot-agent/kernel-dsl": "0.12.0",
    "@dot-agent/sdk": "0.12.0",
    "@dot-agent/tree-sitter": "0.12.0",
    "@hookform/resolvers": "^3.10.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-aspect-ratio": "^1.1.11",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-collapsible": "^1.0.3",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
