#!/usr/bin/env sh
# Shared pre-commit hook (git-native, no husky).
# Activated for every collaborator via `core.hooksPath=.githooks`, set by the
# `prepare` npm script on install. Enforced independently in CI, so a missing
# hook or `--no-verify` cannot land unformatted / unlicensed code.
set -e

# Lint/format only the files staged for this commit — never the whole repo,
# and never `git add .` (that used to silently sweep unrelated pending edits
# and untracked files into whatever commit happened to run next).
staged_ts=$(git diff --cached --name-only --diff-filter=ACM -- "*.ts" "*.tsx")

if [ -n "$staged_ts" ]; then
  # Without a local install (a fresh worktree), npx would fetch the registry's
  # latest major, which fails on a config error that hides the real cause.
  for bin in oxlint prettier; do
    if [ ! -x "node_modules/.bin/$bin" ]; then
      echo "pre-commit: node_modules/.bin/$bin is missing — run npm install in this checkout first." >&2
      exit 1
    fi
  done
  echo "$staged_ts" | xargs npx oxlint --fix
  echo "$staged_ts" | xargs npx prettier --write
  echo "$staged_ts" | xargs git add
fi

bash scripts/ensure-license-headers.sh

# --- The governance gate, after the checks above ---
# Appended rather than replacing this hook: oxlint/prettier autofix and license headers must run first,
# so the gate checks the tree as staged, including whatever the autofix re-staged. `vibe-ops check`
# composes every check itself (built-ins, the ops this repository's config declares) and prints only
# what failed or warned. `set -e` is active, so the gate's nonzero return is captured through `||`.
if ! command -v vibe-ops >/dev/null 2>&1; then
  echo "pre-commit: no \`vibe-ops\` on PATH — this repository's gate cannot run." >&2
  echo "Install it with: npm i -g @entelekheia/vibe-ops-cli" >&2
  exit 2
fi

ROOT=$(git rev-parse --show-toplevel)
GIT_DIR=$(git rev-parse --git-dir)
export GATE_ARTIFACT_DIR="$GIT_DIR/gate-artifacts"
mkdir -p "$GATE_ARTIFACT_DIR"

GATE_RC=0
vibe-ops check "$ROOT" || GATE_RC=$?
exit "$GATE_RC"
