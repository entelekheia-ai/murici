#!/usr/bin/env sh
# Shared pre-commit hook (git-native, no husky).
# Activated for every collaborator via `core.hooksPath=.githooks`, set by the
# `prepare` npm script on install. Enforced independently in CI, so a missing
# hook or `--no-verify` cannot land unformatted / unlicensed code.
set -e

# Lint/format only the files staged for this commit — never the whole repo,
# and never `git add .` (that used to silently sweep unrelated pending edits
# and untracked files into whatever commit happened to run next).
staged_ts=$(git diff --cached --name-only --diff-filter=ACM -- "*.ts" "*.tsx")

if [ -n "$staged_ts" ]; then
  echo "$staged_ts" | xargs npx eslint --fix
  echo "$staged_ts" | xargs npx prettier --write
  echo "$staged_ts" | xargs git add
fi

bash scripts/ensure-license-headers.sh

# --- Plan-020 Track 3: the governance gate, appended after the checks above ---
# Runs the same commit-time governance checks every repository in this workspace runs. Appended rather
# than replacing this hook, which already does real work (eslint/prettier autofix, license headers) that
# must run first — the gate then checks the tree as staged, including whatever the autofix re-staged.
# `set -e` is active from the top of this file, so the gate's own possibly-nonzero return is guarded by
# an `if`, not captured via a bare `$?` after the call, which `set -e` would treat as fatal before the
# capture ever ran.
ROOT=$(git rev-parse --show-toplevel)
CHECK_DIR="$ROOT/scripts/checks"
GIT_DIR=$(git rev-parse --git-dir)
export GATE_ARTIFACT_DIR="$GIT_DIR/gate-artifacts"
mkdir -p "$GATE_ARTIFACT_DIR"

if git diff --cached --name-only --diff-filter=ACMR | grep -q '^scripts/checks/'; then
  if [ -x "$CHECK_DIR/self-test.sh" ]; then
    if ! "$CHECK_DIR/self-test.sh"; then
      echo "pre-commit: the governance fragments' self-test failed — commit refused." >&2
      exit 1
    fi
  fi
fi

if [ ! -f "$CHECK_DIR/_run.sh" ]; then
  echo "pre-commit: $CHECK_DIR/_run.sh not found — scripts/checks/ is missing or moved." >&2
  exit 1
fi
# shellcheck source=scripts/checks/_run.sh
. "$CHECK_DIR/_run.sh"
if run_composed_checks "$ROOT"; then
  GATE_RC=0
else
  GATE_RC=$?
fi

if [ "${GATE_VERBOSE:-}" = "1" ]; then
  printf '%s\n' "$RUN_OUTPUT"
  exit "$GATE_RC"
fi

if [ "$GATE_RC" -ne 0 ]; then
  run_actionable_lines
  exit "$GATE_RC"
fi

printf '%s\n' "$RUN_OUTPUT" | grep -E '^WARN ' || true
